{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indiastack.in/dpi/schema/infrastructure.json",
  "title": "DPI Operational Manifest v1.6",
  "description": "Operational disclosure of structural power. Operators declare facts; they do not self-certify.",
  "type": "object",
  "required": ["meta", "access", "governance"],

  "properties": {

    "meta": {
      "type": "object",
      "required": ["system_id", "deployment", "lifecycle"],
      "properties": {
        "system_id": { "type": "string", "description": "e.g. urn:gov:in:uidai" },
        "deployment": { "type": "string", "enum": ["production", "staging", "pilot"] },
        "lifecycle": { "type": "string", "enum": ["active", "deprecated", "archived"] },
        "license_spdx": { "type": "string", "default": "PROPRIETARY" }
      }
    },

    "operations": {
      "type": "object",
      "description": "Availability promises. Maps to EXIT and AUDIT.",
      "properties": {
        "status_page": { "type": "string", "format": "uri" },
        "slos": {
          "type": "object",
          "properties": {
            "uptime_target": {
              "type": "string",
              "description": "Commitment to availability. If <100% and system is mandatory, this admits exclusion."
            },
            "dispute_resolution": {
              "type": "string",
              "description": "Max time to correct system error. Functions as the audit baseline."
            }
          }
        }
      }
    },

    "governance": {
      "type": "object",
      "description": "Power hierarchy. Maps to GOVERN.",
      "required": ["model", "escalation_paths"],
      "properties": {
        "model": {
          "type": "string",
          "enum": ["community", "foundation", "corporate", "government", "closed"]
        },
        "public_participation": {
          "type": "object",
          "properties": {
            "rfc": { "type": "array", "items": { "type": "string", "format": "uri" } },
            "issues": { "type": "array", "items": { "type": "string", "format": "uri" } }
          }
        },
        "escalation_paths": {
          "type": "array",
          "description": "Who overrules the code? Must be external to operator and non-defeatable.",
          "items": {
            "type": "object",
            "required": ["level", "url", "binding", "binding_proof_url", "binding_proof_hash", "past_enforcement_examples"],
            "properties": {
              "level": { "type": "string", "description": "e.g. Ombudsman, Appellate Tribunal" },
              "url": { "type": "string", "format": "uri" },
              "binding": {
                "type": "boolean",
                "description": "If false, the escalation authority is advisory theater."
              },
              "binding_proof_url": {
                "type": "string",
                "format": "uri",
                "description": "URI to legal/structural document proving binding authority (statute, charter, MoU with enforcement clause)."
              },
              "binding_proof_hash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$",
                "description": "Content integrity hash of the document at binding_proof_url. Format: sha256:<hex>."
              },
              "past_enforcement_examples": {
                "type": "array",
                "items": { "type": "string", "format": "uri" },
                "minItems": 1,
                "description": "URIs to documented cases where this pathway actually overruled operator decisions. REQUIRED for GOVERN pass: at least one historical enforcement example."
              },
              "independence_evidence": {
                "type": "string",
                "format": "uri",
                "description": "URI to documentation proving independence from operator (separate budget, staffing not controlled by operator, jurisdiction not revocable)."
              }
            }
          }
        }
      }
    },

    "components": {
      "type": "object",
      "description": "Source topology. Maps to CODE and FORK.",
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "role": { "type": "string", "enum": ["core", "client", "sdk", "docs"] }
            }
          }
        },
        "closed_components": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Named proprietary dependencies (Antitrust targets)."
        }
      }
    },

    "learned_components": {
      "type": "array",
      "description": "AI systems. Maps to CODE.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["advisory", "decision", "enforcement"] },
          "when_uncertain": {
            "type": "string",
            "enum": ["escalates", "fails_open", "fails_closed", "silent"],
            "description": "Safety mode. 'Silent' indicates fail-deadly design."
          },
          "model_cards": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "training_docs": { "type": "array", "items": { "type": "string", "format": "uri" } }
        }
      }
    },

    "access": {
      "type": "object",
      "description": "Physical access. Maps to EXIT.",
      "required": ["offline_equivalent"],
      "properties": {
        "endpoints": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "offline_channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "url"],
            "properties": {
              "type": { "type": "string", "description": "e.g. Common Service Center" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "offline_equivalent": {
          "type": "boolean",
          "description": "Does offline path provide true parity in time/cost?"
        },
        "data_export": { "type": "array", "items": { "type": "string", "format": "uri" } }
      }
    }
  }
}
